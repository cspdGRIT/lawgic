# LLM_PROVIDER selects which model powers every AI feature (case analysis, chat,
# documents, issue navigator, lawyer matching). anthropic | openai | groq | google |
# cohere | nvidia | ollama — see app/services/llm.py. Default here is groq: free tier,
# open-weight models (Llama 3.3 70B), no local install needed. Get a free key at
# console.groq.com. Switch back to ANTHROPIC_API_KEY + LLM_PROVIDER=anthropic anytime.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
ANTHROPIC_API_KEY=
SECRET_KEY=your-secret-key-here-min-32-chars
DATABASE_URL=sqlite+aiosqlite:///./lawgic.db
ENVIRONMENT=development

# Google sign-in — OAuth client ID from console.cloud.google.com (Credentials -> OAuth client ID -> Web application).
# Leave blank to hide the Google button; also set VITE_GOOGLE_CLIENT_ID (same value) in frontend/.env
GOOGLE_CLIENT_ID=

# Mobile OTP login — SMS_PROVIDER: console (dev default, code goes to the backend log, no account needed)
# | android_gateway (self-hosted, open source: https://github.com/android-sms-gateway/server)
SMS_PROVIDER=console
SMS_GATEWAY_URL=
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Pay-per-outcome credits (dual model alongside the subscription plans — see
# core/access.py + core/credits.py). Four specific paid actions (issue analysis,
# document unlock, lawyer match, research search) draw from subscription quota first,
# then credit_balance. Credits are bought via a UPI QR + admin approval (no gateway
# webhook); pack pricing lives in CREDIT_PACKS (core/credits.py), not here. Never
# commit a real UPI_VPA — set it directly as an env var on your host instead.
UPI_VPA=
UPI_PAYEE_NAME=Lawgic

# Deadline reminders — a daily job (core/scheduler.py, open-source APScheduler,
# in-process, no Redis needed) emails anyone with a case deadline in the next 3 days.
# NOTIFY_PROVIDER: console (dev default, logs the email, no account needed) | smtp
# (any real mailbox — Gmail's free SMTP relay works fine: smtp.gmail.com:587 with an
# app password, not your normal password).
NOTIFY_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Subscriptions — Razorpay (app/api/v1/payments.py). Leave both blank to keep
# /pricing's "Upgrade" flow disabled (returns 501); the frontend still shows real
# plan pricing either way. Get test keys at dashboard.razorpay.com -> Settings -> API Keys.
# Note: this is a one-shot order-and-verify flow, not a recurring subscription — there
# is no webhook, so a plan does not auto-renew and lapses at current_period_end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Legal Research (app/api/v1/research.py) — leave blank to search the ~20-entry
# hardcoded knowledge base only (still functional). Set to also search real case law
# via the Indian Kanoon API (free for non-commercial use): api.indiankanoon.org
INDIAN_KANOON_API_KEY=
